# Python bytecode and caches
__pycache__/
*.py[cod]

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test, coverage and lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

